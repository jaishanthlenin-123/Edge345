# Environment Configuration Template for SG90 Servo Condition Monitoring
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file or real credentials to Git!

# ==============================================================================
# SECURE MQTT (MQTTS) CREDENTIALS
# ==============================================================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT_TLS=8883
MQTT_BROKER_PORT_PLAIN=1883
MQTT_USE_TLS=true
MQTT_USERNAME=edge_servo_operator
MQTT_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
MQTT_CLIENT_ID=rpi5-servo-edge-node01

# Path to TLS certificates on the edge node
MQTT_CA_CERT=/etc/ssl/certs/mosquitto-ca.crt
MQTT_CLIENT_CERT=/etc/ssl/certs/edge-client.crt
MQTT_CLIENT_KEY=/etc/ssl/private/edge-client.key
MQTT_TLS_INSECURE=false

# ==============================================================================
# MODBUS TCP INDUSTRIAL PLC LINK
# ==============================================================================
PLC_MODBUS_HOST=0.0.0.0
PLC_MODBUS_PORT=5020
PLC_SLAVE_ID=1

